{
  "name": "frave-theme",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint:js": "eslint .",
    "lint": "eslint . && composer lint:php",
    "test:e2e": "playwright test",
    "env:start": "wp-env start",
    "env:seed": "wp-env run cli wp eval-file wp-content/themes/frave/tests/e2e/fixtures/seed.php",
    "env:stop": "wp-env stop",
    "package": "git archive --format=zip --prefix=frave/ -o frave.zip HEAD"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@wordpress/env": "^11.16.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@fontsource/lato": "^5.2.0"
  }
}
