<?xml version="1.0"?>
<ruleset name="Frave theme">
	<description>WordPress coding standards and PHP 8.1+ compatibility for the Frave theme.</description>

	<file>.</file>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/assets/dist/*</exclude-pattern>
	<!-- E2E fixtures run only through WP-CLI in the disposable CI site. -->
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="frave"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="frave"/>
			</property>
		</properties>
	</rule>

	<!--
	Template parts run inside load_template() (function scope), so their variables are
	local, not globals. Root templates and page templates still prefix theirs.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/template-parts/*</exclude-pattern>
	</rule>

</ruleset>
