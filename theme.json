{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "brand-orange", "name": "Naranja Frave", "color": "#fc4c02" },
        { "slug": "primary", "name": "Primario accesible", "color": "#c43b00" },
        { "slug": "ink", "name": "Tinta", "color": "#202329" },
        { "slug": "muted", "name": "Texto secundario", "color": "#6b6b68" },
        { "slug": "surface", "name": "Superficie", "color": "#f6f4f1" },
        { "slug": "line", "name": "Borde", "color": "#e5e1dc" },
        { "slug": "success", "name": "Éxito", "color": "#276749" },
        { "slug": "warning", "name": "Aviso", "color": "#9c6b1b" },
        { "slug": "error", "name": "Error", "color": "#b42318" },
        { "slug": "white", "name": "Blanco", "color": "#ffffff" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "0.5rem" },
        { "slug": "30", "name": "S", "size": "0.75rem" },
        { "slug": "40", "name": "M", "size": "1rem" },
        { "slug": "50", "name": "L", "size": "1.5rem" },
        { "slug": "60", "name": "XL", "size": "2rem" },
        { "slug": "70", "name": "2XL", "size": "3rem" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        { "fontFamily": "Lato, Arial, sans-serif", "slug": "body", "name": "Lato" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Pequeño", "size": "0.875rem" },
        { "slug": "medium", "name": "Mediano", "size": "1rem" },
        { "slug": "large", "name": "Grande", "size": "1.5rem" },
        { "slug": "x-large", "name": "Extra grande", "size": "2.5rem" }
      ]
    }
  },
  "styles": {
    "color": { "background": "#ffffff", "text": "#202329" },
    "typography": { "fontFamily": "Lato, Arial, sans-serif", "fontSize": "1rem", "lineHeight": "1.6" },
    "elements": {
      "link": { "color": { "text": "#202329" } },
      "button": { "border": { "radius": "999px" } }
    }
  }
}
