# Hostinger's LiteSpeed serves .webm as text/plain: browsers that check the type
# skip that source. Same cache lifetime the server already gives images.
<IfModule mod_mime.c>
	AddType video/webm .webm
	AddType video/mp4 .mp4
</IfModule>
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType video/webm "access plus 7 days"
	ExpiresByType video/mp4 "access plus 7 days"
</IfModule>
